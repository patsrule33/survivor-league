rules_version = '2';
// Draft room: anyone with the link can read drafts and make picks (family
// league, no sign-in). Writes are limited to the one shape the page uses.
service cloud.firestore {
  match /databases/{database}/documents {
    match /drafts/{draftId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if draftId.matches('s[0-9]+')
        && request.resource.data.keys().hasOnly(['state', 'updated'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 20000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
