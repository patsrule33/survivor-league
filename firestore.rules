rules_version = '2';
// Family league. Everyone can read. The commissioner (signed in with Google,
// identified by Firebase user ID, not email) can do anything. Everyone else can
// only make their own draft pick: exactly one, in turn, from the pool.
service cloud.firestore {
  match /databases/{database}/documents {

    function isCommish() {
      return request.auth != null && request.auth.uid == '9iaNj5YudyYR6b4rZcuOzKhpyRo2';
    }

    // ---- Draft room: drafts/s51 etc. (stored as real fields so these checks work) ----
    match /drafts/{draftId} {
      allow read: if true;
      // start, mark eliminated, undo, delete: commissioner only
      allow create, update, delete: if isCommish() && draftId.matches('s[0-9]+');
      // anyone: add one pick
      allow update: if draftId.matches('s[0-9]+') && isValidPick(resource.data, request.resource.data);
      // s999: scratch draft for automated rule tests (holds nothing real)
      allow create, delete: if draftId == 's999';
    }

    // od.snake = the full pick order (owner per pick), written when the
    // commissioner starts the draft, so turn order needs no arithmetic here.
    // A pick may change only `picks`, `taken` (and the server timestamp), adding
    // exactly one new entry to each, for the owner whose turn it is.
    function isValidPick(od, nd) {
      return nd.keys().hasOnly(['season', 'createdAt', 'startBoot', 'owners', 'snake', 'rosterSize',
                                'pool', 'out', 'picks', 'taken', 'test', 'updated'])
        && sameSetup(od, nd)
        && nd.taken.size() == od.taken.size() + 1
        && nd.picks.size() == od.taken.size() + 1
        && nd.taken.hasAll(od.taken)
        && nd.picks.hasAll(od.picks)
        && od.taken.size() < od.snake.size()
        && isNewPick(od, nd.taken[od.taken.size()], nd.picks[od.taken.size()]);
    }

    function sameSetup(od, nd) {
      return nd.get('season', null) == od.get('season', null)
        && nd.get('createdAt', null) == od.get('createdAt', null)
        && nd.get('startBoot', null) == od.get('startBoot', null)
        && nd.get('owners', null) == od.get('owners', null)
        && nd.get('snake', null) == od.get('snake', null)
        && nd.get('rosterSize', null) == od.get('rosterSize', null)
        && nd.get('pool', null) == od.get('pool', null)
        && nd.get('out', null) == od.get('out', null)
        && nd.get('test', null) == od.get('test', null);
    }

    function isNewPick(od, name, pick) {
      return (name in od.pool) && !(name in od.taken) && !(name in od.out)
        && pick.keys().hasOnly(['owner', 'name', 'at'])
        && pick.name == name
        && pick.owner == od.snake[od.taken.size()];
    }

    // ---- Scoring review: reviews/s51 etc. Commissioner only. ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isCommish() && reviewId.matches('s[0-9]+');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
